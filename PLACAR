<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Placar de Sinuca</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f4f3;
      color: #222;
      margin: 0;
      padding: 24px;
      text-align: center;
    }

    h1 {
      margin-bottom: 28px;
    }

    .placar {
      display: grid;
      grid-template-columns: 1fr auto auto auto 1fr;
      align-items: center;
      gap: 16px;
      max-width: 900px;
      margin: 0 auto 30px;
    }

    .jogador {
      background: white;
      border: 3px solid #ccc;
      border-radius: 12px;
      padding: 18px;
      cursor: pointer;
    }

    .jogador.selecionado {
      border-color: #16834a;
      background: #e8f5ed;
    }

    .nome {
      width: 90%;
      font-size: 18px;
      text-align: center;
      padding: 8px;
    }

    .pontos {
      font-size: 64px;
      font-weight: bold;
      margin: 12px 0;
    }

    .instrucao {
      font-size: 14px;
      color: #555;
    }

    .frames {
      min-width: 80px;
    }

    .numero-frames {
      font-size: 36px;
      font-weight: bold;
      margin: 8px;
    }

    button, select {
      font-size: 18px;
      padding: 10px 14px;
      margin: 5px;
      cursor: pointer;
    }

    .botoes-pontos {
      margin: 20px auto;
    }

    .botoes-pontos button {
      min-width: 54px;
      font-size: 22px;
    }

    .falta {
      margin: 25px auto;
    }

    .zerar {
      margin-top: 20px;
      font-size: 15px;
    }

    @media (max-width: 650px) {
      body {
        padding: 12px;
      }

      .placar {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .jogador {
        grid-column: span 1;
      }

      .frames {
        grid-column: span 1;
      }

      .pontos {
        font-size: 48px;
      }
    }
  </style>
</head>

<body>
  <h1>Placar de Sinuca</h1>

  <div class="placar">
    <div class="jogador selecionado" id="cartao1" onclick="selecionarJogador(1)">
      <input class="nome" id="nome1" value="Jogador 1" aria-label="Nome do Jogador 1">
      <div class="pontos" id="pontos1">0</div>
      <div class="instrucao" id="aviso1">Selecionado</div>
    </div>

    <div class="frames">
      <div>Frames</div>
      <div class="numero-frames" id="frames1">0</div>
      <button onclick="alterarFrames(1, 1)">+</button>
      <button onclick="alterarFrames(1, -1)">−</button>
    </div>

    <div style="font-size: 28px; font-weight: bold;">X</div>

    <div class="frames">
      <div>Frames</div>
      <div class="numero-frames" id="frames2">0</div>
      <button onclick="alterarFrames(2, 1)">+</button>
      <button onclick="alterarFrames(2, -1)">−</button>
    </div>

    <div class="jogador" id="cartao2" onclick="selecionarJogador(2)">
      <input class="nome" id="nome2" value="Jogador 2" aria-label="Nome do Jogador 2">
      <div class="pontos" id="pontos2">0</div>
      <div class="instrucao" id="aviso2">Clique para selecionar</div>
    </div>
  </div>

  <h2>Adicionar pontos ao jogador selecionado</h2>

  <div class="botoes-pontos">
    <button onclick="somarPontos(1)">1</button>
    <button onclick="somarPontos(2)">2</button>
    <button onclick="somarPontos(3)">3</button>
    <button onclick="somarPontos(4)">4</button>
    <button onclick="somarPontos(5)">5</button>
    <button onclick="somarPontos(6)">6</button>
    <button onclick="somarPontos(7)">7</button>
  </div>

  <div class="falta">
    <label for="valorFalta">Falta:</label>
    <select id="valorFalta">
      <option value="4">4 pontos</option>
      <option value="5">5 pontos</option>
      <option value="6">6 pontos</option>
      <option value="7">7 pontos</option>
    </select>
    <button onclick="registrarFalta()">Aplicar falta</button>
  </div>

  <button class="zerar" onclick="zerarPlacar()">Zerar placar</button>

  <script>
    let jogadorSelecionado = 1;

    function selecionarJogador(numero) {
      jogadorSelecionado = numero;

      document.getElementById("cartao1").classList.toggle("selecionado", numero === 1);
      document.getElementById("cartao2").classList.toggle("selecionado", numero === 2);

      document.getElementById("aviso1").textContent =
        numero === 1 ? "Selecionado" : "Clique para selecionar";

      document.getElementById("aviso2").textContent =
        numero === 2 ? "Selecionado" : "Clique para selecionar";
    }

    function somarPontos(valor) {
      const placar = document.getElementById("pontos" + jogadorSelecionado);
      placar.textContent = Number(placar.textContent) + valor;
    }

    function registrarFalta() {
      const adversario = jogadorSelecionado === 1 ? 2 : 1;
      const valor = Number(document.getElementById("valorFalta").value);
      const placar = document.getElementById("pontos" + adversario);

      placar.textContent = Number(placar.textContent) + valor;
    }

    function alterarFrames(jogador, quantidade) {
      const placarFrames = document.getElementById("frames" + jogador);
      const novoTotal = Number(placarFrames.textContent) + quantidade;

      if (novoTotal >= 0) {
        placarFrames.textContent = novoTotal;
      }
    }

    function zerarPlacar() {
      document.getElementById("pontos1").textContent = 0;
      document.getElementById("pontos2").textContent = 0;
      document.getElementById("frames1").textContent = 0;
      document.getElementById("frames2").textContent = 0;
      selecionarJogador(1);
    }
  </script>
</body>
</html>
